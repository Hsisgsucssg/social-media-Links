{
  "name": "next-gen-digital-card",
  "version": "2.0.0",
  "description": "Next-generation digital business card with advanced sharing and analytics",
  "main": "js/main.js",
  "scripts": {
    "build": "npm run build-css && npm run build-js",
    "build-css": "postcss style.css -o dist/style.css",
    "build-js": "webpack --mode production",
    "dev": "webpack serve --mode development --open",
    "watch": "concurrently \"npm run watch-css\" \"npm run watch-js\"",
    "watch-css": "postcss style.css -o dist/style.css --watch",
    "watch-js": "webpack --mode development --watch",
    "lint": "eslint js/**/*.js",
    "format": "prettier --write js/**/*.js",
    "test": "jest",
    "serve": "http-server . -p 8080 -c-1"
  },
  "keywords": [
    "digital-card",
    "social-profile",
    "business-card",
    "qr-code",
    "vcard",
    "analytics"
  ],
  "author": "Digital Card Creator",
  "license": "MIT",
  "dependencies": {
    "qrcode": "^1.5.3",
    "ical.js": "^1.5.0",
    "gsap": "^3.12.4",
    "vanilla-lazyload": "^17.8.8",
    "confetti": "^1.6.0"
  },
  "devDependencies": {
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "babel-loader": "^9.1.3",
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "html-webpack-plugin": "^5.6.0",
    "postcss": "^8.4.32",
    "postcss-cli": "^11.0.0",
    "autoprefixer": "^10.4.16",
    "tailwindcss": "^3.3.6",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "http-server": "^14.1.1",
    "concurrently": "^8.2.2"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}